---
layout: layouts/base.njk
---
<div class="hero">
<div class="hero-copy">
  <h1>{{ profile.name }} <span class="chinese-name" lang="zh-CN">{{ profile.chineseName }}</span>
</h1>
  <aside class="portrait-card" aria-label="Portrait of {{ profile.name }}">
<div class="portrait-frame">
{% image profile.portrait, profile.portraitAlt, false %}
</div>
</aside>
  <p class="intro">{{ profile.intro }}</p>
<p class="intro-secondary">{{ profile.summary }}</p>
  <div class="hero-links" aria-label="Profile links">
{% for link in profile.links %}
{% set target = profile[link.key] %}
<a class="text-link" href="{% if link.key == 'email' %}mailto:{% endif %}{{ target }}"{% if link.kind == 'download' %} target="_blank" rel="noopener noreferrer"{% elif target.startsWith('http') %} rel="noopener noreferrer"{% endif %}>{{ link.label }}{% if link.kind == 'download' %} ↗{% endif %}
</a>
{% endfor %}
</div>
  <div class="research-tags" aria-label="Research interests">
<strong>Interests</strong>
{% for interest in profile.interests %}
<span>{{ interest }}</span>
{% endfor %}
</div>
</div>
</div>
{% if content | trim %}
<div class="prose">{{ content | safe }}</div>
{% endif %}
<div class="home-records">
  {% if experience.length %}
<section class="home-record-group" aria-labelledby="experience-title">
<h2 id="experience-title">Experience</h2>
<div class="home-record-list">
  {% for item in experience | newest('start') %}
<article class="timeline-item">
<p class="timeline-date">{{ item.start | displayDate }} — {{ item.end | displayDate }}</p>
<h3>{{ item.title }}{% if item.status == 'upcoming' %} <span class="status-label">Upcoming</span>
{% endif %}
</h3>
<p>{{ item.institution }}{% if item.location %} · {{ item.location }}{% endif %}
</p>
{% if item.host %}
<p class="timeline-note">Host: {{ item.host }}</p>
{% endif %}
</article>
{% endfor %}
  </div>
</section>
{% endif %}
  <section class="home-record-group" aria-labelledby="education-title">
<h2 id="education-title">Education</h2>
<div class="home-record-list">
  {% for item in education | newest('start') %}
<article class="timeline-item">
<p class="timeline-date">{{ item.start | displayDate }} — {{ item.end | displayDate }}</p>
<h3>{{ item.title }}</h3>
<p>{{ item.institution }}</p>
{% if item.advisor %}
<p class="timeline-note">Advisor: <a href="{{ item.advisor.url }}" rel="noopener noreferrer">{{ item.advisor.name }} ↗</a>
</p>
{% endif %}
</article>
{% endfor %}
  </div>
</section>
</div>
<section class="news-section" aria-labelledby="news-title" data-filter-group data-filter-key="news" data-default-filter="current">
  <div class="news-header">
<h2 id="news-title">News</h2>
<div class="news-filters filter-controls" data-filter-controls role="group" aria-label="Filter news">
{% for key in ['current','past','all'] %}
<button type="button" data-filter="{{ key }}" aria-pressed="{{ 'true' if key == 'current' else 'false' }}">{{ key | capitalize }}</button>
{% endfor %}
</div>
</div>
  <div class="news-list" aria-live="polite" tabindex="0" aria-label="News updates">
{% for item in news | newest %}
<article class="news-item" data-filter-item data-category="{{ item.group }}">
<time datetime="{{ item.date }}">{{ item.date | displayDate }}</time>
<p>{{ item.text }}</p>
<span class="news-kind">{{ item.category }}</span>
</article>
{% endfor %}
</div>
  <p class="empty-state" data-filter-empty hidden>No news in this group.</p>
</section>

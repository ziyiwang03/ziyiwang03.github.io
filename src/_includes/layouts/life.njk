---
layout: layouts/base.njk
---
<div class="life-landing">
<header class="page-intro life-intro">
<h1>{{ title }}</h1>
<div class="prose">{{ content | safe }}</div>
</header>
<nav class="life-directory" aria-label="Life sections">
{% for item in life %}
<a href="{{ item.url }}">
<span>
<strong>{{ item.label }}</strong>
<small>{{ item.description }}</small>
</span>
<span aria-hidden="true">→</span>
</a>
{% endfor %}
</nav>
</div>
